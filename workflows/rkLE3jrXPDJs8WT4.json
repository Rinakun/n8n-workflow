    {
      "parameters": {
        "jsCode": "const rawOutput = $input.first().json.text || $input.first().json.output || '';\nconst telegramMsg = $('Telegram Trigger').first().json.message;\n\nlet parsed = {};\n\ntry {\n  // Ambil hanya karakter dari kurung kurawal pertama '{' sampai terakhir '}'\n  const jsonMatch = rawOutput.match(/\\{[\\s\\S]*\\}/);\n  if (jsonMatch) {\n    parsed = JSON.parse(jsonMatch[0]);\n  } else {\n    throw new Error(\"Format JSON tidak ditemukan\");\n  }\n} catch (err) {\n  // Jika benar-benar bukan JSON, jadikan balasan biasa\n  parsed = {\n    type: \"general\",\n    reply: rawOutput || \"Halo! Kirimkan tugas atau jadwal yang ingin dicatat ya.\"\n  };\n}\n\nreturn {\n  json: {\n    ...parsed,\n    chatId: telegramMsg.chat.id,\n    rawInput: telegramMsg.text\n  }\n};"
      },
